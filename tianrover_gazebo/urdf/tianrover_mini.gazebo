<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
  <xacro:property name="mu" value="1.2" />






    <gazebo reference="Body">
        <material>Gazebo/Gold</material>
    </gazebo>










    <gazebo reference="LeftMainRocket">
        <material>Gazebo/Red</material>
    </gazebo>
    <gazebo reference="RightMainRocket">
        <material>Gazebo/Red</material>
    </gazebo>
    <gazebo reference="LeftViceRocket">
        <material>Gazebo/Blue</material>
    </gazebo>
    <gazebo reference="RightViceRocket">
        <material>Gazebo/Blue</material>
    </gazebo>


    <gazebo reference="Body_RightMainRocket">
        <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>
    <gazebo reference="Body_LeftMainRocket">
        <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>


    <gazebo reference="RightMainRocket_RightViceRocket">
        <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>
    <gazebo reference="LeftMainRocket_LeftViceRocket">
        <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>




    <gazebo reference="RightMainRocket_BogieRF">
        <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>
    <gazebo reference="LeftMainRocket_BogieLF">
        <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>


    <gazebo reference="RightViceRocket_BogieRB">
        <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>
    <gazebo reference="RightViceRocket_BogieRM">
        <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>
    <gazebo reference="LeftViceRocket_BogieLB">
        <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>
    <gazebo reference="LeftViceRocket_BogieLM">
        <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>




    <gazebo reference="BogieLF_WheelLF">
        <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>
    <gazebo reference="BogieLB_WheelLB">
        <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>
    <gazebo reference="BogieLM_WheelLM">
        <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>
    <gazebo reference="BogieRF_WheelRF">
        <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>
    <gazebo reference="BogieRB_WheelRB">
        <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>
    <gazebo reference="BogieRM_WheelRM">
        <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>




    <gazebo reference="WheelLF">
        <material>Gazebo/Grey</material>
        <mu1>${mu}</mu1>
        <mu2>${mu}</mu2>
    </gazebo>

    <gazebo reference="WheelLB">
        <material>Gazebo/Grey</material>
        <mu1>${mu}</mu1>
        <mu2>${mu}</mu2>
    </gazebo>

    <gazebo reference="WheelLM">
        <material>Gazebo/Grey</material>
        <mu1>${mu}</mu1>
        <mu2>${mu}</mu2>
    </gazebo>


    <gazebo reference="WheelRF">
        <material>Gazebo/Grey</material>
        <mu1>${mu}</mu1>
        <mu2>${mu}</mu2>
    </gazebo>

    <gazebo reference="WheelRB">
        <material>Gazebo/Grey</material>
        <mu1>${mu}</mu1>
        <mu2>${mu}</mu2>
    </gazebo>

    <gazebo reference="WheelRM">
        <material>Gazebo/Grey</material>
        <mu1>${mu}</mu1>
        <mu2>${mu}</mu2>
    </gazebo>






















































    <gazebo>

        <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros><namespace>/$(arg namespace)</namespace></ros>

            <joint_name>Body_LeftMainRocket</joint_name>
<joint_name>LeftMainRocket_LeftViceRocket</joint_name>
<joint_name>LeftViceRocket_BogieLM</joint_name>
<joint_name>BogieLM_WheelLM</joint_name>
<joint_name>LeftViceRocket_BogieLB</joint_name>
<joint_name>BogieLB_WheelLB</joint_name>
<joint_name>LeftMainRocket_BogieLF</joint_name>
<joint_name>BogieLF_WheelLF</joint_name>
<joint_name>Body_RightMainRocket</joint_name>
<joint_name>RightMainRocket_RightViceRocket</joint_name>
<joint_name>RightViceRocket_BogieRM</joint_name>
<joint_name>BogieRM_WheelRM</joint_name>
<joint_name>RightViceRocket_BogieRB</joint_name>
<joint_name>BogieRB_WheelRB</joint_name>
<joint_name>RightMainRocket_BogieRF</joint_name>
<joint_name>BogieRF_WheelRF</joint_name>
            <update_rate>100.0</update_rate>
        </plugin>


        <plugin name="skid_steer_drive_controller" filename="libTianRoverDriver_plugins.so">
      <ros><namespace>/$(arg namespace)</namespace></ros>
            <rosDebugLevel>Debug</rosDebugLevel>
            <broadcastTF>true</broadcastTF>
            <publishWheelJointState>true</publishWheelJointState>
            <alwaysOn>true</alwaysOn>
            <updateRate>100.0</updateRate>
            <legacyMode>true</legacyMode>

            <RFWheelJoint>BogieRF_WheelRF</RFWheelJoint>
            <LFWheelJoint>BogieLF_WheelLF</LFWheelJoint>
            <RMWheelJoint>BogieRM_WheelRM</RMWheelJoint>
            <LMWheelJoint>BogieLM_WheelLM</LMWheelJoint>
            <RBWheelJoint>BogieRB_WheelRB</RBWheelJoint>
            <LBWheelJoint>BogieLB_WheelLB</LBWheelJoint>
            <RFBogieJoint>RightMainRocket_BogieRF</RFBogieJoint>
            <LFBogieJoint>LeftMainRocket_BogieLF</LFBogieJoint>
            <RBBogieJoint>RightViceRocket_BogieRB</RBBogieJoint>
            <LBBogieJoint>LeftViceRocket_BogieLB</LBBogieJoint>


            <rightRockerJoint>Body_RightMainRocket</rightRockerJoint>
            <leftRockerJoint>Body_LeftMainRocket</leftRockerJoint>
            <wheelSeparation>0.4937</wheelSeparation>
            <frontWheelSeparation>0.47414</frontWheelSeparation>
            <middleWheelSeparation>0.58729</middleWheelSeparation>
            <rearWheelSeparation>0.51325</rearWheelSeparation>
            <wheelBase>0.62813</wheelBase>
            <wheelDiameter>0.15</wheelDiameter>
            <commandTopic>cmd_vel</commandTopic>
            <ackermannTopic>ackermann_cmd</ackermannTopic>
            <roverMotionModeTopic>rover_motion_mode</roverMotionModeTopic>
            <PathTopic>abs_path</PathTopic>
            <odometryTopic>odom</odometryTopic>
            <odometryFrame>$(arg frame_prefix)odom</odometryFrame>
            <robotBaseFrame>$(arg frame_prefix)base_footprint</robotBaseFrame>
            <commandTimeout>0.5</commandTimeout>

            <torque>100</torque>
            <steeringPGain>30.0</steeringPGain>
            <steeringIGain>0.0</steeringIGain>
            <steeringDGain>2.0</steeringDGain>
            <steeringTorque>50.0</steeringTorque>
            <steeringRate>0.6</steeringRate>
            <rockerDifferentialPGain>20.0</rockerDifferentialPGain>
            <rockerDifferentialDGain>2.0</rockerDifferentialDGain>
            <rockerDifferentialTorque>10.0</rockerDifferentialTorque>
            <rockerDifferentialTarget>0.0</rockerDifferentialTarget>
        </plugin>

        <xacro:if value="$(arg enable_skid_rate)">

            <plugin name="WRF_RotationRate" filename="libComputeSkidRate_plugins.so">
      <ros><namespace>/$(arg namespace)</namespace></ros>
                <updateRate>100</updateRate>
                <WheelRF>WheelRF</WheelRF>
                <WheelRF_RefLink>BogieRF</WheelRF_RefLink>
                <WheelLF>WheelLF</WheelLF>
                <WheelLF_RefLink>BogieLF</WheelLF_RefLink>
                <WheelRM>WheelRM</WheelRM>
                <WheelRM_RefLink>BogieRM</WheelRM_RefLink>
                <WheelLM>WheelLM</WheelLM>
                <WheelLM_RefLink>BogieLM</WheelLM_RefLink>
                <WheelRB>WheelRB</WheelRB>
                <WheelRB_RefLink>BogieRB</WheelRB_RefLink>
                <WheelLB>WheelLB</WheelLB>
                <WheelLB_RefLink>BogieLB</WheelLB_RefLink>
                <Body>base_footprint</Body>
                <bodyFrame>$(arg frame_prefix)base_footprint</bodyFrame>
                <SkidRateTopicName>SkidRate</SkidRateTopicName>
                <WheelVelPoseTopicName>VelPose</WheelVelPoseTopicName>
                <WheelPoseInBodyTopicName>WheelPoseInBody</WheelPoseInBodyTopicName>
            </plugin>
        </xacro:if>
    </gazebo>

</robot>
