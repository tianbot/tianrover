<?xml version="1.0"?>
<package format="3">
  <name>tianrover_gazebo</name>
  <version>0.1.0</version>
  <description>ROS 2 migration of the TianRover Mini Gazebo Classic simulation.</description>
  <maintainer email="support@tianbot.com">Tianbot</maintainer>
  <license>BSD-3-Clause</license>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>gazebo_ros</depend>
  <depend>gazebo_dev</depend>
  <depend>ackermann_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>eigen</depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tianrover_common</exec_depend>
  <exec_depend>tianrover_teleop</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>tf2_msgs</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/..:${prefix}/meshes" plugin_path="${prefix}/../../lib"/>
  </export>
</package>
